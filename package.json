{
    "name": "wechatide-lite-plugins",
    "version": "0.1.0",
    "description": "Open WeChat DevTools Lite after the first successful webpack or Vite watch build.",
    "license": "MIT",
    "engines": {
        "node": ">=20.19.0"
    },
    "exports": {
        "./webpack": {
            "types": "./types/webpack.d.ts",
            "default": "./src/webpack.cjs"
        },
        "./vite": {
            "import": { "types": "./types/vite.d.mts", "default": "./src/vite.mjs" },
            "require": { "types": "./types/vite.d.cts", "default": "./src/vite.cjs" }
        }
    },
    "files": [
        "src",
        "types",
        "docs/testing.md",
        "README.md",
        "LICENSE"
    ],
    "scripts": {
        "test": "node --test --test-concurrency=1 test/*.test.cjs",
        "test:unit": "node --test test/core.test.cjs",
        "test:integration": "node --test --test-concurrency=1 test/builders.test.cjs",
        "test:uni": "node --test test/uni.cjs",
        "test:types": "tsc --noEmit",
        "lint": "eslint ."
    },
    "peerDependencies": {
        "vite": ">=5 <9",
        "webpack": ">=5 <6"
    },
    "peerDependenciesMeta": {
        "vite": {
            "optional": true
        },
        "webpack": {
            "optional": true
        }
    },
    "devDependencies": {
        "@dcloudio/uni-app": "^3.0.0-5020620260917001",
        "@dcloudio/uni-components": "^3.0.0-5020620260917001",
        "@dcloudio/uni-mp-weixin": "^3.0.0-5020620260917001",
        "@dcloudio/vite-plugin-uni": "^3.0.0-5020620260917001",
        "@eslint/js": "^9.39.0",
        "eslint": "^9.39.0",
        "globals": "^16.5.0",
        "typescript": "^5.9.3",
        "vite": "5.2.8",
        "vite-modern": "npm:vite@8.3.8",
        "vue": "^3.4.21",
        "webpack": "^5.111.1"
    },
    "repository": {
        "type": "git",
        "url": "https://github.com/JUST-Limbo/wechatide-lite-plugins.git"
    },
    "keywords": [
        "uni-app",
        "wechat",
        "miniprogram",
        "lite",
        "vite-plugin",
        "webpack-plugin"
    ]
}
